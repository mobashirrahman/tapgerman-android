<?xml version="1.0" encoding="utf-8"?>
<!--
  The themed-icon layer for Android 13+ monochrome launcher icons.

  A themed icon is tinted a single colour by the system, so anything that relies on contrast
  between two of its own colours disappears. This version therefore reduces to a page outline
  with the two outer lines cut out and the middle one left solid, which still reads as "a page
  with a marked line" at 48dp once the system has painted it flat.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108"
    android:tint="?android:attr/colorControlNormal">

    <!-- Page, with line one and line two knocked out of it -->
    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M40,24 h28 a14,14 0 0 1 14,14 v32 a14,14 0 0 1 -14,14 h-28 a14,14 0 0 1 -14,-14 v-32 a14,14 0 0 1 14,-14 z M40,34 h30 a4,4 0 0 1 4,4 v0 a4,4 0 0 1 -4,4 h-30 a4,4 0 0 1 -4,-4 v0 a4,4 0 0 1 4,-4 z M40,69 h26 a4,4 0 0 1 4,4 v0 a4,4 0 0 1 -4,4 h-26 a4,4 0 0 1 -4,-4 v0 a4,4 0 0 1 4,-4 z" />

    <!-- The marked line, solid -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M42,50 h18 a6,6 0 0 1 6,6 v1 a6,6 0 0 1 -6,6 h-18 a6,6 0 0 1 -6,-6 v-1 a6,6 0 0 1 6,-6 z" />
</vector>
