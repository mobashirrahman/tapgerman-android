<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark: a page of text with one word marked.

  The product's whole idea is that you tap a word in a German article and find out what it means,
  so the identity is that gesture rather than a speech bubble or a book.

  An earlier draft put a white rounded plate on the gradient with the bars inside it. Rendering it
  showed the problem straight away: a shape inside a shape inside a launcher mask is three levels of
  nesting, and at 48dp it collapsed into a generic list icon. Dropping the plate leaves the text
  block directly on the gradient, which is bolder and higher contrast.

  Three bars share a left edge and have ragged right ends, so the block reads as lines of text
  rather than a stack of equal pills. The middle bar is taller *and* accented: height carries the
  signal as well as hue, because hue alone stops reading at 48dp.

  The sizing was measured rather than guessed. Android's adaptive-icon mask is the centre 72x72 of
  the 108x108 canvas, so anything past radius 36 can be cropped, and the platform's key line is
  radius 33. The geometry is scaled about the centre until its furthest point sits at 32.5.
  tools/render_icon.py rasterises these vectors against circle, squircle and full-bleed masks at
  512, 192, 96 and 48px; rendering is what caught the first version overflowing the circle.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Line one -->
    <path
        android:fillColor="#F2F0FF"
        android:pathData="M35,31.5 h34.5 a4.5,4.5 0 0 1 4.5,4.5 v0 a4.5,4.5 0 0 1 -4.5,4.5 h-34.5 a4.5,4.5 0 0 1 -4.5,-4.5 v0 a4.5,4.5 0 0 1 4.5,-4.5 z" />

    <!-- The marked word: same left edge, taller, in the accent -->
    <path
        android:fillColor="#C9F53C"
        android:pathData="M36.5,47.5 h23 a6,6 0 0 1 6,6 v0.5 a6,6 0 0 1 -6,6 h-23 a6,6 0 0 1 -6,-6 v-0.5 a6,6 0 0 1 6,-6 z" />

    <!-- Line two -->
    <path
        android:fillColor="#F2F0FF"
        android:pathData="M35,66.5 h29.5 a4.5,4.5 0 0 1 4.5,4.5 v0 a4.5,4.5 0 0 1 -4.5,4.5 h-29.5 a4.5,4.5 0 0 1 -4.5,-4.5 v0 a4.5,4.5 0 0 1 4.5,-4.5 z" />
</vector>
